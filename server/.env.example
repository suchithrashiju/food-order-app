NODE_ENV=development

PORT=3000

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/

DATABASE=food-order-app

CORS_ORIGIN=http://localhost:5173

ADMIN_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_EXPIRES_IN_SECONDS=28800

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@foodorder.local
ADMIN_PASSWORD=admin@2026

# Optional. When set, POST /api/admin/seed requires this value in
# the `x-seed-secret` header or JSON body `{ "seedSecret": "..." }`.
# Required in production if you keep the seed endpoint enabled.
# SEED_SECRET=replace-with-a-seed-secret
